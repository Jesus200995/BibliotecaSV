# Configuración para tu VPS específico
# Copia este archivo como .env.local y cambia la IP por la de tu VPS

# Ejemplo para VPS con IP específica:
VITE_API_URL=http://31.97.8.51:4000/api
VITE_APP_URL=http://31.97.8.51

# O si usas un puerto específico para el frontend:
# VITE_API_URL=http://31.97.8.51:4000/api
# VITE_APP_URL=http://31.97.8.51:5174

# Configuración adicional
NODE_ENV=production
